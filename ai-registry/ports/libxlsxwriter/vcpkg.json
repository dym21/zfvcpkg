{
  "name": "libxlsxwriter",
  "version": "1.2.4",
  "port-version": 2,
  "description": "Libxlsxwriter is a C library that can be used to write Excel 2007+ XLSX files.",
  "homepage": "https://github.com/jmcnamara/libxlsxwriter",
  "documentation": "https://libxlsxwriter.github.io",
  "license": "BSD-2-Clause",
  "dependencies": [
    "minizip",
    {
      "name": "minizip",
      "features": [
        "unofficial-iowin32"
      ],
      "platform": "windows"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    "zlib"
  ],
  "features": {
    "dtoa": {
      "description": "Use the Milo Yip DTOA library"
    },
    "mem-file": {
      "description": "Use memory files instead of temp files",
      "supports": "!windows"
    },
    "openssl-md5": {
      "description": "Use Openssl MD5",
      "dependencies": [
        "openssl"
      ]
    }
  }
}
