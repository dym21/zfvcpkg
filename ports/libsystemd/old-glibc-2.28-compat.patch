diff --git a/src/include/override/unistd.h b/src/include/override/unistd.h
index 5f36ae6e40..c6c62d0925 100644
--- a/src/include/override/unistd.h
+++ b/src/include/override/unistd.h
@@ -3,6 +3,32 @@
 
 #include_next <unistd.h>        /* IWYU pragma: export */
 
+/* gettid() was added to glibc in 2.30. */
+#if defined(__GLIBC__) && !__GLIBC_PREREQ(2, 30)
+#  include <sys/syscall.h>
+
+static inline pid_t missing_gettid(void) {
+        return (pid_t) syscall(__NR_gettid);
+}
+#  define gettid missing_gettid
+#endif
+
+/* close_range() was added to glibc in 2.34. */
+#if defined(__GLIBC__) && !__GLIBC_PREREQ(2, 34)
+static inline int missing_close_range(unsigned first_fd, unsigned last_fd, unsigned flags) {
+        return (int) syscall(__NR_close_range, first_fd, last_fd, flags);
+}
+#  define close_range missing_close_range
+#endif
+
+/* getdents64() was made public in glibc 2.30. */
+#if defined(__GLIBC__) && !__GLIBC_PREREQ(2, 30)
+static inline ssize_t missing_getdents64(int fd, void *buffer, size_t length) {
+        return (ssize_t) syscall(__NR_getdents64, fd, buffer, length);
+}
+#  define getdents64 missing_getdents64
+#endif
