diff --git a/src/include/override/malloc.h b/src/include/override/malloc.h
new file mode 100644
index 0000000000..7682877081
--- /dev/null
+++ b/src/include/override/malloc.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include_next <malloc.h>        /* IWYU pragma: export */
+
+/* mallinfo2() was added in glibc 2.33.  The old-world LoongArch ABI is
+ * intentionally tied to glibc 2.28, so convert the older mallinfo result.
+ * This is sufficient for sd_event_trim_memory(), which only reads arena and
+ * hblkhd to report how much memory malloc_trim() returned to the OS. */
+#if defined(__GLIBC__) && !__GLIBC_PREREQ(2, 33)
+struct mallinfo2 {
+        size_t arena;
+        size_t ordblks;
+        size_t smblks;
+        size_t hblks;
+        size_t hblkhd;
+        size_t usmblks;
+        size_t fsmblks;
+        size_t uordblks;
+        size_t fordblks;
+        size_t keepcost;
+};
+
+static inline struct mallinfo2 mallinfo2(void) {
+        struct mallinfo m = mallinfo();
+
+        return (struct mallinfo2) {
+                .arena = (size_t) m.arena,
+                .ordblks = (size_t) m.ordblks,
+                .smblks = (size_t) m.smblks,
+                .hblks = (size_t) m.hblks,
+                .hblkhd = (size_t) m.hblkhd,
+                .usmblks = (size_t) m.usmblks,
+                .fsmblks = (size_t) m.fsmblks,
+                .uordblks = (size_t) m.uordblks,
+                .fordblks = (size_t) m.fordblks,
+                .keepcost = (size_t) m.keepcost,
+        };
+}
+#endif
